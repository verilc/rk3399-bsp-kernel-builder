# ============================================================================
# rockchip-armbian.fragment
#
# 作用：在 rockchip_linux_defconfig 的基础上，补齐跑 Armbian/Debian 用户态、
#       容器、网络和 TN3399_V3 板载外设所需的选项。
#
# 为什么需要它：rockchip_linux_defconfig 是给 Rockchip 自家 Linux SDK 用的，
#   实测缺少 OVERLAY_FS / BRCMFMAC / Docker 网络(netfilter+veth+bridge) 等选项。
#   不补的话新内核能起来，但 Docker、WiFi 会用不了。
#
# 使用方式（工作流里已自动执行）：
#   make ARCH=arm64 rockchip_linux_defconfig
#   ./scripts/kconfig/merge_config.sh -m .config <本文件>
#   make ARCH=arm64 olddefconfig
#
# ★ 注意：merge_config.sh 的第一个参数必须是【基底配置 .config】（源码里 INITFILE=$1），
#   漏掉它会把片段本身当成整份配置的基底，导致 rockchip_linux_defconfig 被丢弃。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. MPP 硬件编解码 —— RK3399 的 H.264 硬编码就在这里
#    VEPU2 = Video Encoder v2 = H.264 编码器（本次改造的核心目标）
#    VDPU2 = 解码器；RKVDEC = 4K 解码器（HEVC/VP9）
# ---------------------------------------------------------------------------
CONFIG_ROCKCHIP_MPP_SERVICE=y
CONFIG_ROCKCHIP_MPP_VEPU2=y
CONFIG_ROCKCHIP_MPP_VDPU2=y
CONFIG_ROCKCHIP_MPP_RKVDEC=y
CONFIG_ROCKCHIP_MPP_IEP2=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_ROCKCHIP=y
CONFIG_DMABUF_HEAPS_ROCKCHIP_CMA_HEAP=y
# 关掉 Rockchip 自己的 dma-buf 调试输出，否则 dmesg 会被刷屏
# CONFIG_RK_DMABUF_DEBUG is not set
# CONFIG_DMABUF_RK_HEAPS_DEBUG is not set

# ---------------------------------------------------------------------------
# 2. 用户态基础：initramfs / 文件系统 / systemd 需要的接口
# ---------------------------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_ZRAM=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_MISC=y
CONFIG_COMPAT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_PSI=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUDIT=y
CONFIG_LOCALVERSION_AUTO=n

# ---------------------------------------------------------------------------
# 3. cgroup / 命名空间 —— Docker、LXC、systemd 沙箱依赖
# ---------------------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NETPRIO_CGROUP=y

# ---------------------------------------------------------------------------
# 4. 容器文件系统与网络 —— Docker 必需
# ---------------------------------------------------------------------------
CONFIG_OVERLAY_FS=y
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_TUN=m
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=m

# ---------------------------------------------------------------------------
# 5. TN3399_V3 板载外设
# ---------------------------------------------------------------------------

# 千兆以太网（RGMII）
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y

# 板载 WiFi/BT：BCM43455（SDIO 接 WiFi，UART 接蓝牙）
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_MSGBUF=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_RFKILL=y
CONFIG_SERIAL_DEV_BUS=y

# RTC（HYM8563）
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_HYM8563=m

# USB 与 USB 摄像头（你的输入源是 UVC 摄像头，必须有这个）
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEOBUF2_VMALLOC=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y

# eMMC / SD（启动介质）
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# ---------------------------------------------------------------------------
# 6. 调度 / 调频 / 温控 —— 长时间跑编码时相关
# ---------------------------------------------------------------------------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_THERMAL=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_ARM_ROCKCHIP_CPUFREQ=y

# ---------------------------------------------------------------------------
# 7. 兼容性兜底（避免用户态工具缺失）
# ---------------------------------------------------------------------------
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_CIFS=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_SHA256=y
